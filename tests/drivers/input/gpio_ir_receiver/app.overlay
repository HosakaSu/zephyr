#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	ir: ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	legacy_ir: vs1838b {
		compatible = "vishay,vs1838b";
		data-gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
